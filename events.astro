---
import BaseLayout from '../layouts/BaseLayout.astro';
import EventCard from '../components/EventCard.astro';
import { getCollection } from 'astro:content';

const all = await getCollection('events');
const upcoming = all.filter(e => e.data.status === 'upcoming').sort((a, b) => a.data.date.localeCompare(b.data.date));
const past = all.filter(e => e.data.status === 'past').sort((a, b) => b.data.date.localeCompare(a.data.date));
---
<BaseLayout
  title="Events & Projects"
  description="Upcoming events and past service projects run by Rotaract KUL."
>
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Events & projects</p>
      <h1>What we're running.</h1>
      <p class="intro-lede">Placeholder events shown below until real dates are confirmed — each one is a single file, so adding or updating an event never touches the page itself.</p>
    </div>
  </section>

  <section class="section section--tint">
    <div class="wrap">
      <h2>Upcoming</h2>
      <div class="grid grid--2">
        {upcoming.map(event => <EventCard {...event.data} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>Past</h2>
      <div class="grid grid--2">
        {past.map(event => <EventCard {...event.data} />)}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .intro-lede { max-width: 60ch; color: var(--stone); font-size: 1.05rem; }
</style>
