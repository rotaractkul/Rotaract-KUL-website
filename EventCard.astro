---
interface Props {
  title: string;
  date: string;
  location: string;
  summary: string;
  image?: string;
  registrationLink?: string;
  status: 'upcoming' | 'past';
}

const { title, date, location, summary, image, registrationLink, status } = Astro.props;

const formatted = new Date(date + 'T00:00:00').toLocaleDateString('en-GB', {
  day: 'numeric', month: 'short', year: 'numeric',
});
---
<article class="event-card">
  <div class="event-card__media" style={image ? `background-image:url(${image})` : ''}>
    {!image && <span>Photo placeholder</span>}
  </div>
  <div class="event-card__body">
    <p class="event-card__meta">{formatted} · {location}</p>
    <h3>{title}</h3>
    <p>{summary}</p>
    {status === 'upcoming' && registrationLink && (
      <a class="btn btn--ghost" href={registrationLink} target="_blank" rel="noopener noreferrer">Register</a>
    )}
  </div>
</article>

<style>
  .event-card {
    border: 1px solid #E7E1D8;
    background: var(--paper);
    display: flex;
    flex-direction: column;
  }

  .event-card__media {
    aspect-ratio: 4 / 3;
    background: var(--paper-dim);
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--stone);
    font-size: 0.85rem;
  }

  .event-card__body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    flex: 1;
  }

  .event-card__meta {
    font-size: 0.85rem;
    color: var(--burgundy-600);
    font-weight: 600;
    margin: 0;
  }

  .event-card__body h3 { margin-bottom: 0; }
  .event-card__body p:not(.event-card__meta) { margin: 0; font-size: 0.95rem; color: var(--stone); }
  .event-card__body .btn { margin-top: auto; align-self: flex-start; }
</style>
