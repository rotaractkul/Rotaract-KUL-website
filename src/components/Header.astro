---
const links = [
  { href: '/about', label: 'About' },
  { href: '/what-we-do', label: 'What We Do' },
  { href: '/events', label: 'Events' },
  { href: '/team', label: 'Team' },
  { href: '/partnerships', label: 'Partnerships' },
  { href: '/contact', label: 'Contact' },
];
const current = Astro.url.pathname;
---
<header class="site-header">
  <div class="wrap site-header__bar">
    <a href="/" class="site-header__logo">
      <!-- Replace with the official Rotaract logo mark when available -->
      <span class="site-header__mark" aria-hidden="true">R</span>
      <span>Rotaract KUL</span>
    </a>

    <button class="site-header__toggle" id="nav-toggle" aria-expanded="false" aria-controls="site-nav">
      <span class="visually-hidden">Toggle menu</span>
      <span class="site-header__toggle-line"></span>
      <span class="site-header__toggle-line"></span>
    </button>

    <nav id="site-nav" class="site-header__nav">
      <ul>
        {links.map(link => (
          <li>
            <a href={link.href} aria-current={current === link.href ? 'page' : undefined}>{link.label}</a>
          </li>
        ))}
      </ul>
      <a href="/join-us" class="btn btn--primary site-header__cta">Join Us</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(253, 252, 251, 0.92);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid #E7E1D8;
  }

  .site-header__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1rem;
    padding-bottom: 1rem;
  }

  .site-header__logo {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 1.15rem;
    color: var(--charcoal);
  }

  .site-header__mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--burgundy-900);
    color: var(--paper);
    font-family: var(--font-display);
    font-size: 1rem;
  }

  .site-header__nav {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .site-header__nav ul {
    display: flex;
    gap: 1.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-header__nav a {
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--charcoal);
    padding-bottom: 2px;
    border-bottom: 1px solid transparent;
  }

  .site-header__nav a[aria-current="page"] {
    border-bottom-color: var(--burgundy-600);
  }

  .site-header__nav a:hover {
    border-bottom-color: var(--stone);
  }

  .site-header__toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    padding: 0.5rem;
    cursor: pointer;
  }

  .site-header__toggle-line {
    width: 22px;
    height: 2px;
    background: var(--charcoal);
  }

  @media (max-width: 860px) {
    .site-header__toggle { display: flex; }

    .site-header__nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: flex-start;
      gap: 1.5rem;
      background: var(--paper);
      border-bottom: 1px solid #E7E1D8;
      padding: 1.5rem var(--gutter) 2rem;
      display: none;
    }

    .site-header__nav.is-open {
      display: flex;
    }

    .site-header__nav ul {
      flex-direction: column;
      gap: 1rem;
      width: 100%;
    }
  }
</style>

<script>
  const toggle = document.getElementById('nav-toggle');
  const nav = document.getElementById('site-nav');
  toggle?.addEventListener('click', () => {
    const isOpen = nav?.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
  });
</script>
