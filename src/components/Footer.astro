---
import { INSTAGRAM_URL, LINKEDIN_URL, CONTACT_EMAIL } from '../site-config';
const social = { instagram: INSTAGRAM_URL, linkedin: LINKEDIN_URL, email: CONTACT_EMAIL };
---
<footer class="site-footer">
  <div class="wrap site-footer__grid">
    <div>
      <p class="site-footer__brand">Rotaract KUL</p>
      <p>A student community for service, professional growth and connection — proudly part of the wider Rotaract network.</p>
    </div>

    <div>
      <h3 class="site-footer__heading">Explore</h3>
      <ul class="site-footer__list">
        <li><a href="/about">About</a></li>
        <li><a href="/what-we-do">What We Do</a></li>
        <li><a href="/events">Events & Projects</a></li>
        <li><a href="/join-us">Join Us</a></li>
      </ul>
    </div>

    <div>
      <h3 class="site-footer__heading">Connect</h3>
      <ul class="site-footer__list">
        <li><a href={`mailto:${social.email}`}>{social.email}</a></li>
        <li><a href={social.instagram} target="_blank" rel="noopener noreferrer">Instagram</a></li>
        <li><a href={social.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
      </ul>
    </div>
  </div>

  <div class="wrap site-footer__bottom">
    <p>&copy; {new Date().getFullYear()} Rotaract KUL. Not a formal organ of KU Leuven or Rotary International.</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--charcoal);
    color: #D8D3CC;
    padding: 3.5rem 0 1.5rem;
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: 2.5rem;
    padding-bottom: 2.5rem;
  }

  .site-footer__brand {
    font-family: var(--font-display);
    font-size: 1.3rem;
    color: var(--paper);
    margin: 0 0 0.75rem;
  }

  .site-footer__heading {
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--paper);
    margin: 0 0 1rem;
  }

  .site-footer__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }

  .site-footer__list a {
    text-decoration: none;
    color: #D8D3CC;
  }
  .site-footer__list a:hover { color: var(--paper); }

  .site-footer__bottom {
    border-top: 1px solid rgba(255,255,255,0.12);
    padding-top: 1.25rem;
    font-size: 0.85rem;
    color: #A39C90;
  }

  @media (max-width: 700px) {
    .site-footer__grid { grid-template-columns: 1fr; }
  }
</style>
