---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Events & Projects"
  description="Events and projects from Rotaract KUL Campus Brussels — coming soon."
>
  <section class="section coming-soon">
    <div class="wrap">
      <p class="eyebrow">Events</p>
      <h1>Coming soon.</h1>
      <p>We're currently preparing our first activities. Check back soon for upcoming events and opportunities to get involved.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .coming-soon { min-height: 40vh; display: flex; align-items: center; }
  .coming-soon p { max-width: 55ch; color: var(--stone); font-size: 1.1rem; }
</style>
