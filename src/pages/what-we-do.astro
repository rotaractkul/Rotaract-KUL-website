---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="What We Do"
  description="Projects and initiatives from Rotaract KUL Campus Brussels — coming soon."
>
  <section class="section coming-soon">
    <div class="wrap">
      <p class="eyebrow">What we do</p>
      <h1>Coming soon.</h1>
      <p>We're currently developing our first projects and initiatives. More information will be available here soon.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .coming-soon { min-height: 40vh; display: flex; align-items: center; }
  .coming-soon p { max-width: 55ch; color: var(--stone); font-size: 1.1rem; }
</style>
