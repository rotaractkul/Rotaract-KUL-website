---
import BaseLayout from '../layouts/BaseLayout.astro';
import { JOIN_FORM_URL } from '../site-config';

const reasons = [
  'Build a portfolio of real service and leadership experience.',
  'Meet people outside your own programme and year.',
  'Get access to workshops, mentors and company contacts.',
  'Join a network that extends well beyond Leuven.',
];

const departments = [
  'Community Service',
  'Professional Development',
  'Marketing & Events',
  'Partnerships',
  'HR / People',
  'Treasury & Finance',
];
---
<BaseLayout
  title="Join Us"
  description="Why and how to join Rotaract KUL — who can join, what departments are open and what to expect as a member."
>
  <section class="section join-hero">
    <div class="wrap">
      <p class="eyebrow">Join us</p>
      <h1>Put your time toward something that lasts.</h1>
      <p class="intro-lede">Membership is open to students across KU Leuven and Odisee. No prior experience is required — just interest and a willingness to show up.</p>
      <a class="btn btn--primary" href={JOIN_FORM_URL} target="_blank" rel="noopener noreferrer">Apply to join</a>
    </div>
  </section>

  <section class="section section--tint">
    <div class="wrap grid grid--2">
      <div>
        <h2>Why join?</h2>
        <ul class="plain-list">
          {reasons.map(r => <li>{r}</li>)}
        </ul>
      </div>
      <div>
        <h2>Who can join?</h2>
        <p>Any student currently enrolled at KU Leuven or Odisee. We welcome all study programmes, years and backgrounds — the only requirement is genuine interest in service and community.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>Departments you can get involved in</h2>
      <div class="grid grid--3 dept-grid">
        {departments.map(d => <div class="dept-card">{d}</div>)}
      </div>
    </div>
  </section>

  <section class="section section--dark">
    <div class="wrap cta-block">
      <h2>What to expect as a member</h2>
      <p>Regular meetings, a mix of service and social events, and as much responsibility as you're willing to take on — every department is run by members, for members.</p>
      <a class="btn btn--primary" href={JOIN_FORM_URL} target="_blank" rel="noopener noreferrer">Apply / Join Rotaract KUL</a>
    </div>
  </section>
</BaseLayout>

<style>
  .intro-lede { max-width: 60ch; color: var(--stone); font-size: 1.1rem; margin-bottom: 1.75rem; }
  .plain-list { margin: 0; padding-left: 1.1rem; color: var(--stone); display: grid; gap: 0.6rem; }
  .dept-grid { margin-top: 1.5rem; }
  .dept-card {
    border: 1px solid #E7E1D8;
    padding: 1.5rem;
    font-family: var(--font-display);
    font-size: 1.1rem;
  }
  .cta-block { max-width: 46ch; }
  .cta-block p { margin-bottom: 1.75rem; }
</style>
